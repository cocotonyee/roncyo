{
  "installCommand": "npm install --no-workspaces --legacy-peer-deps",
  "redirects": [
    {
      "source": "/terms",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/journal",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/journal/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/labs",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/labs/:path*",
      "destination": "/blog",
      "permanent": true
    }
  ]
}
