# Roncyo www — GoShip Site profile (Hub will set these in production)
# Roncyo www — GoShip Site profile (Hub will set these in production)
# Only set GOSHIP_SITE_ID when Hub/Supabase seo_documents is connected.
# Without a DB, SITE_ID alone pulls GoShip demo posts into /blog.
# GOSHIP_SITE_ID=roncyo
GOSHIP_SITE_NAME=Roncyo
GOSHIP_SITE_DOMAIN=https://roncyo.com
GOSHIP_SITE_LOCALE=en
GOSHIP_SITE_DESCRIPTION=Roncyo designs, launches, and grows focused digital products - tools, apps, and experiments people use.
GOSHIP_PRODUCT_BLURB=A studio that builds and ships digital products.
GOSHIP_ORG_NAME=RONCY LLC
GOSHIP_CONTACT_EMAIL=support@roncyo.com

NEXT_PUBLIC_SITE_URL=https://roncyo.com
NEXT_PUBLIC_SITE_NAME=Roncyo
NEXT_PUBLIC_SITE_DESCRIPTION=Roncyo designs, launches, and grows focused digital products - tools, apps, and experiments people use.

# Optional plugins (comma-separated): auth,stripe,telemetry
# Leave empty to auto-detect from credentials.
PLUGINS_ENABLED=

# Auth (optional — when Hub / Supabase is wired)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Billing (optional)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Telemetry / mail (optional)
# GOSHIP_TELEMETRY_KEY=
# GOSHIP_TELEMETRY_URL=
# RESEND_API_KEY=
